<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\PhoneCam.Core\PhoneCam.Core.csproj" />

        <PackageReference Include="FFmpeg.AutoGen" Version="8.0.0" />
        <PackageReference Include="FFmpeg.Native" Version="1.0.0-r31" />
        <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.1" />
        <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
<DisableRuntimeMarshalling>false</DisableRuntimeMarshalling>
<PlatformTarget>x64</PlatformTarget>
  <Prefer32Bit>false</Prefer32Bit>

        <!-- было: net8.0-windows -->
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>

        <!-- чтобы атрибуты SupportedOSPlatformVersion не конфликтовали -->
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

        <UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>13.0</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

</Project>
